{
  "manifest_version": 3,
  "name": "Lines Checker: ads.txt/app-ads.txt/sellers.json",
  "version": "7.6.1",
  "description": "Check ads.txt and app-ads.txt, find errors and duplicates, and verify seller IDs against sellers.json directly in Chrome",
  "icons": {
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "ui/popup/popup.html",
    "default_title": "Lines Checker"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/ads.txt*",
        "*://*/app-ads.txt*",
        "*://*/*/ads.txt*",
        "*://*/*/app-ads.txt*"
      ],
      "js": [
        "shared/utils.js",
        "shared/ui.js",
        "content/overlay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
